{
    "version": "0.2.0",
    "configurations": [

        

        

        {
            "name": "Debug auxexpr eval 000",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/auxexpr",
            "args": ["eval", "000"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/main/envs:${workspaceFolder}/main/envs/dst:${workspaceFolder}/py:${workspaceFolder}"
                },
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}:${workspaceFolder}/external/qhull/lib:${workspaceFolder}/external/clp/dist/lib:/home/michael/anaconda3/envs/thts++mo/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-auxexpr-debug-with-py-env",
            "miDebuggerPath": "/usr/bin/gdb"
        },
