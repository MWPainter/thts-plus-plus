{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-auxexpr-debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "source ~/anaconda3/etc/profile.d/conda.sh && conda activate thts++mo && source export_local_paths_desktop.sh && make auxexpr-debug"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "build-pyex-debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "source ~/anaconda3/etc/profile.d/conda.sh && conda activate thts++mo && source export_local_paths_desktop.sh && make pyex-debug"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "build-thts-test-debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "source ~/anaconda3/etc/profile.d/conda.sh && conda activate thts++mo && source export_local_paths_desktop.sh && make thts-test-debug"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "build-moexpr-debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "source ~/anaconda3/etc/profile.d/conda.sh && conda activate thts++mo && source export_local_paths_desktop.sh && make moexpr-debug"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "build-py_env_server-debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "source ~/anaconda3/etc/profile.d/conda.sh && conda activate thts++mo && source export_local_paths_desktop.sh && make py_env_server-debug"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "build-auxexpr-debug-with-py-env",
            "dependsOn": ["build-py_env_server-debug", "build-auxexpr-debug"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build-pyex-debug-with-py-env",
            "dependsOn": ["build-py_env_server-debug", "build-pyex-debug"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build-moexpr-debug-with-py-env",
            "dependsOn": ["build-py_env_server-debug", "build-moexpr-debug"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"]
        }
    ]
}

